<UserControl x:Class="GlassNotes.Controls.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Formatting buttons take their color from the note text so they work on any background -->
        <Style x:Key="FormatButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=Root}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Highlight" CornerRadius="6"
                                    Background="{TemplateBinding Foreground}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <RichTextBox x:Name="Editor"
                     BorderThickness="0" Background="Transparent"
                     Foreground="{Binding Foreground, ElementName=Root}"
                     CaretBrush="{Binding Foreground, ElementName=Root}"
                     SelectionBrush="{DynamicResource TextSelectionBrush}"
                     FontSize="{Binding FontSize, ElementName=Root}"
                     FontFamily="{Binding FontFamily, ElementName=Root}"
                     AcceptsReturn="True" AcceptsTab="True"
                     IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                </Style>
                <Style TargetType="List">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="22,0,0,0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Formatting bar, like Windows Sticky Notes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,2,4,0">
            <ToggleButton x:Name="BoldButton" Style="{StaticResource FormatButton}"
                          Click="BoldButton_Click" ToolTip="Bold (Ctrl+B)">
                <TextBlock Text="B" FontWeight="Bold" FontFamily="Segoe UI"/>
            </ToggleButton>
            <ToggleButton x:Name="ItalicButton" Style="{StaticResource FormatButton}"
                          Click="ItalicButton_Click" ToolTip="Italic (Ctrl+I)">
                <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
            </ToggleButton>
            <ToggleButton x:Name="UnderlineButton" Style="{StaticResource FormatButton}"
                          Click="UnderlineButton_Click" ToolTip="Underline (Ctrl+U)">
                <TextBlock Text="U" TextDecorations="Underline" FontFamily="Segoe UI"/>
            </ToggleButton>
            <ToggleButton x:Name="StrikeButton" Style="{StaticResource FormatButton}"
                          Click="StrikeButton_Click" ToolTip="Strikethrough (Ctrl+T)">
                <TextBlock Text="ab" TextDecorations="Strikethrough" FontFamily="Segoe UI"/>
            </ToggleButton>
            <ToggleButton x:Name="BulletsButton" Style="{StaticResource FormatButton}"
                          Click="BulletsButton_Click" ToolTip="Bullet list (Ctrl+Shift+L)">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
