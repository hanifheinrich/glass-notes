<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme: white paper, warm gray chrome, gold accent from the app icon -->

    <!-- Surfaces -->
    <Color x:Key="WindowBackgroundColor">#FFFFFF</Color>   <!-- note editor and sidebar -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F6F6F4</Color>            <!-- title bar and bottom toolbar -->
    <Color x:Key="SurfaceHoverColor">#EBEBE9</Color>
    <Color x:Key="SurfacePressedColor">#E0E0DE</Color>
    <Color x:Key="BorderColor">#E5E5E3</Color>

    <!-- Inputs and popups -->
    <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ControlBorderColor">#DADAD7</Color>
    <Color x:Key="PopupBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PopupHoverColor">#F2F2F0</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
    <Color x:Key="TextSecondaryColor">#6B6B70</Color>
    <Color x:Key="TextTertiaryColor">#9C9CA2</Color>
    <Color x:Key="TextSelectionColor">#3390FF</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#E0A800</Color>
    <Color x:Key="AccentSoftColor">#24E0A800</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>

    <!-- Notes list -->
    <Color x:Key="NoteItemBackgroundColor">#00000000</Color>
    <Color x:Key="NoteItemHoverBackgroundColor">#08000000</Color>
    <Color x:Key="NoteItemSelectedBackgroundColor">#F1F1EF</Color>
    <Color x:Key="NoteItemSelectedBorderColor">#E3E3E0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}"/>
    <SolidColorBrush x:Key="PopupHoverBrush" Color="{StaticResource PopupHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextSelectionBrush" Color="{StaticResource TextSelectionColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="NoteItemBackgroundBrush" Color="{StaticResource NoteItemBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteItemHoverBackgroundBrush" Color="{StaticResource NoteItemHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteItemSelectedBackgroundBrush" Color="{StaticResource NoteItemSelectedBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteItemSelectedBorderBrush" Color="{StaticResource NoteItemSelectedBorderColor}"/>

</ResourceDictionary>
