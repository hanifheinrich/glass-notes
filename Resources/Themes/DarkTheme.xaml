<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme: neutral graphite surfaces, off-white text to avoid glare, gold accent from the app icon -->

    <!-- Surfaces -->
    <Color x:Key="WindowBackgroundColor">#1E1E20</Color>   <!-- note editor and sidebar -->
    <Color x:Key="BackgroundColor">#1E1E20</Color>
    <Color x:Key="SurfaceColor">#26262A</Color>            <!-- title bar and bottom toolbar -->
    <Color x:Key="SurfaceHoverColor">#313136</Color>
    <Color x:Key="SurfacePressedColor">#3A3A40</Color>
    <Color x:Key="BorderColor">#323237</Color>

    <!-- Inputs and popups -->
    <Color x:Key="ControlBackgroundColor">#2A2A2F</Color>
    <Color x:Key="ControlBorderColor">#3C3C43</Color>
    <Color x:Key="PopupBackgroundColor">#2B2B30</Color>
    <Color x:Key="PopupHoverColor">#37373D</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#E8E8EA</Color>
    <Color x:Key="TextSecondaryColor">#A1A1A9</Color>
    <Color x:Key="TextTertiaryColor">#6F6F78</Color>
    <Color x:Key="TextSelectionColor">#4C8DF0</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#F0C33C</Color>
    <Color x:Key="AccentSoftColor">#2EF0C33C</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>

    <!-- Notes list -->
    <Color x:Key="NoteItemBackgroundColor">#00FFFFFF</Color>
    <Color x:Key="NoteItemHoverBackgroundColor">#0DFFFFFF</Color>
    <Color x:Key="NoteItemSelectedBackgroundColor">#2E2E34</Color>
    <Color x:Key="NoteItemSelectedBorderColor">#3E3E46</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}"/>
    <SolidColorBrush x:Key="PopupHoverBrush" Color="{StaticResource PopupHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextSelectionBrush" Color="{StaticResource TextSelectionColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="NoteItemBackgroundBrush" Color="{StaticResource NoteItemBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteItemHoverBackgroundBrush" Color="{StaticResource NoteItemHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteItemSelectedBackgroundBrush" Color="{StaticResource NoteItemSelectedBackgroundColor}"/>
    <SolidColorBrush x:Key="NoteItemSelectedBorderBrush" Color="{StaticResource NoteItemSelectedBorderColor}"/>

</ResourceDictionary>
